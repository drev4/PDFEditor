# Database
DATABASE_URL="postgresql://user:password@localhost:5432/vuepdf?schema=public"

# JWT
JWT_SECRET="your-super-secret-key-change-in-production"
# JWT_EXPIRES_IN is gone. It set a single 7-day session token; sessions are now
# an access token (JWT_ACCESS_TTL) plus a revocable refresh token
# (REFRESH_TOKEN_TTL_DAYS), both below.

# Server
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# ─── Who may create an account ───────────────────────────────────────────────
# `open`        — anybody with the URL can register. The normal state.
# `invite_only` — POST /api/auth/register requires REGISTRATION_CODE below and
#                 answers 403 without it. What the private beta runs on.
#
# **Unset means `open`, and that default is only safe because a strict
# environment refuses to boot without this variable set explicitly** — see
# config/validate-env.ts. Strictness is an allowlist on NODE_ENV, so anything
# that is not exactly `development` or `test` must name a mode. Leaving it empty
# here is correct for local development.
#
# It does NOT gate `POST /api/organizations/invitations/accept`: somebody
# redeeming an invitation was already admitted by a customer, and closing that
# path would lock out the colleagues of paying accounts (features/0033).
REGISTRATION_MODE=

# The shared signup code, sent to beta customers by email. At least 16
# characters, and required whenever REGISTRATION_MODE=invite_only — the two
# together refuse to boot if the code is missing, rather than starting with a
# door nothing can open. Generate one with:  openssl rand -base64 24
#
# It is shared, so anyone it is forwarded to can register. That is accepted
# while the beta is free. Never logged, and never returned by any endpoint.
REGISTRATION_CODE=

# Reverse proxies in front of this process (0 = none).
# Decides what req.ip is, and therefore whether rate limiting identifies the
# real client. Set it to the number of proxies you actually have. Never "true":
# that makes req.ip a client-controlled header and the limiters stop working.
TRUST_PROXY_HOPS=0

# Rate limits on the unauthenticated write paths. Windows are milliseconds.
# The login window counts failed attempts only, so normal use cannot exhaust it.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_RESPONSES_MAX=20
RATE_LIMIT_RESPONSES_WINDOW_MS=600000

# Public base URL of this API, used to build the URLs returned by the upload
# route. Wrong value here silently produces broken PDF links.
BASE_URL="http://localhost:3000"

# How long a signed PDF URL stays valid, in seconds (minimum 60).
# The link is a bearer capability: anyone holding it can fetch that PDF until it
# expires, so longer is not free. Long enough that a slow page load never races
# it; short enough that a link leaked into a browser history or a proxy log is
# worthless by the time anyone finds it.
UPLOAD_URL_TTL_SECONDS=900

# Send Strict-Transport-Security. Off by default and it must stay off for any
# deployment reachable over plain HTTP, including local development: a browser
# that sees HSTS from localhost will force HTTPS on localhost for every port
# afterwards, which breaks unrelated local work in a way that is very hard to
# trace back here. Turn it on where TLS actually terminates.
ENABLE_HSTS=false

# Access-token lifetime. Minutes, not days: an access token cannot be revoked
# (verifying one must not cost a database round trip), so this is the window in
# which a stolen one is still useful. Session length is controlled by the
# refresh token below, which is revocable.
JWT_ACCESS_TTL=15m

# Refresh-token lifetime, in days. This is how long a user stays logged in.
REFRESH_TOKEN_TTL_DAYS=7

# Rate limit on POST /api/auth/refresh, which is unauthenticated by definition.
RATE_LIMIT_REFRESH_MAX=60
RATE_LIMIT_REFRESH_WINDOW_MS=900000

# `Secure` on the refresh cookie. Leave true: browsers treat localhost as a
# trustworthy origin, so a Secure cookie works over plain HTTP in development.
# Set false only for a non-localhost deployment served over plain HTTP.
COOKIE_SECURE=true

# How long an invitation link stays valid, in hours. The link is a bearer
# capability — there is no email service, so the inviter copies it and sends it
# themselves — which means anyone holding it can spend it until it expires.
INVITATION_TTL_HOURS=72

# Rate limit on POST /api/organizations/invitations/accept, which is
# unauthenticated by design and grants access to an organization.
RATE_LIMIT_INVITATION_MAX=20
RATE_LIMIT_INVITATION_WINDOW_MS=900000

# ─── Stripe (features/0013) ──────────────────────────────────────────────────
# All three are optional: with none of them set, billing is simply off and
# `POST /api/billing/checkout` and `/portal` answer 503. Nothing else in the
# application changes, and no test needs them.
#
# Everything below works in Stripe **test mode**, which needs no company and no
# real card. Get the keys from the Stripe dashboard in test mode; get the
# webhook secret from `stripe listen --forward-to localhost:3000/api/billing/webhook`.

# Secret API key (`sk_test_…` in test mode). The only credential that can charge
# anyone; it is read by `src/services/stripe.ts` and by nothing else.
STRIPE_SECRET_KEY=

# Signing secret for the webhook (`whsec_…`). **This is the one to get right.**
# It is what proves a request to `POST /api/billing/webhook` came from Stripe,
# and a wrong value fails every signature check — silently, with the endpoint
# still answering 400 to Stripe and 200 to nobody. The symptom is not an error
# in this application: it is subscriptions that are paid for and never activate,
# and cancellations that never apply. `stripe listen` prints a *different*
# secret from the dashboard's; the local one is the one to use locally.
STRIPE_WEBHOOK_SECRET=

# The Stripe **price id** for the Pro plan (`price_…`) — not an amount. The
# amount lives in Stripe and nowhere else, which is why no price is stored in
# `services/plans.ts` or rendered from a constant in the SPA: nobody has decided
# the real numbers yet (docs/BACKLOG.md), and this id can point at a €1 test
# price today and a real one later with no code change.
#
# When it is unset, checkout answers 503. When it points at a price that is not
# the one a subscription is actually on, `planKeyForStatus` refuses to guess
# which tier was bought and resolves that organization to free, with an error in
# the log naming this variable.
STRIPE_PRICE_PRO=

# The Stripe **price id** for the Team plan (`price_…`), which is billed **per
# seat** — a recurring price with `usage_type=licensed` and a per-unit amount, so
# that a quantity means something (features/0015).
#
# Optional and independent of the one above: unset means Team is simply not for
# sale on this deployment, `POST /api/billing/checkout` answers 503 for it, and
# Free and Pro are unaffected. Set it wrong and a Team subscription resolves to
# free with an error in the log naming both price variables — `planKeyForPrice`
# refusing to guess which tier was bought.
#
# **The seat count is bought, not billed after the fact.** This application never
# sends Stripe a quantity except the opening one on a Checkout line item; the
# customer changes it in the portal, and `assertCanInvite` refuses the seat that
# was not paid for. That requires the portal configuration to have *Update
# quantities* on — see docs/sot/08-operations.md, which also covers *Switch plan*
# and scheduling downgrades at the period end.
STRIPE_PRICE_TEAM=

# ─── PDF storage (features/0016) ─────────────────────────────────────────────
# Where uploaded PDFs live. `services/pdf-storage.ts` is the only module that
# reads or writes the bytes; nothing else may open a PDF by name.
#
#   local   the API process's own disk, at `backend/uploads/pdfs` (the default)
#   s3      any S3-compatible object store — AWS S3, Cloudflare R2, MinIO
#
# **Unset means `local`, and `local` is what this repository has always done.**
# The test suites run on it, so `npm test` needs no bucket and no network.
#
# An unrecognised value **refuses to start**, which is the opposite of how
# DEV_PLAN_KEY and the rate limits treat bad input. The difference is what the
# mistake costs: falling back to local disk would accept uploads and lose them
# at the next deploy, so there is no safe direction to guess in.
#
# Switching to `s3` does **not** move the files already on disk. A form uploaded
# before the switch keeps a `pdfUrl` whose object is not in the bucket, and its
# PDF stops resolving until the file is copied across. Copy first, then switch.
PDF_STORAGE_DRIVER=

# Required when the driver is `s3`; the server refuses to boot without it.
PDF_STORAGE_BUCKET=

# The bucket must be **private**. The only route to a PDF is this API's signed,
# expiring URL (features/0006), and a public bucket would hand every customer
# document to anyone who guessed a key — undoing that from the storage side.

# `auto` suits Cloudflare R2; AWS wants a real region such as `eu-west-1`.
PDF_STORAGE_REGION=

# Leave empty for AWS. R2 is `https://<account>.r2.cloudflarestorage.com`, and a
# local MinIO from docker-compose.yml is `http://localhost:9000`.
PDF_STORAGE_ENDPOINT=

# Leave both empty to use the SDK's own credential chain — instance roles, IRSA,
# `~/.aws/credentials`. A deployment on IAM should not have to invent a key.
PDF_STORAGE_ACCESS_KEY_ID=
PDF_STORAGE_SECRET_ACCESS_KEY=

# `true` for MinIO, which has no wildcard DNS, so the bucket goes in the path
# rather than in the hostname. AWS and R2 do not need it.
PDF_STORAGE_FORCE_PATH_STYLE=

# Key prefix inside the bucket. Defaults to `pdfs/`, which keeps a shared bucket
# legible and lets a lifecycle rule target these objects alone.
PDF_STORAGE_PREFIX=

# --- The job queue (features/0017) -------------------------------------------
# Where the PDF embed runs.
#
# **Unset means there is no queue**: the embed runs inline inside the bulk-save
# request, serialised per form by an in-process lock, exactly as this
# application has always done. That is the default, it is what the three test
# suites run on, and it needs no Redis and no second process.
#
# Set it, and `POST /api/forms/:formId/fields/bulk` enqueues instead - which
# means **a worker must be running** (`npm run worker`, or `npm run worker:dev`
# while developing). With this set and no worker alive, jobs pile up and no
# form's PDF is ever rewritten: nothing errors, no request fails, and every
# document silently falls behind its fields. See docs/sot/08-operations.md for
# how to tell whether a worker is alive.
#
# Rolling back is emptying this line and restarting the API. There is nothing to
# migrate: jobs are reconstructible, a re-save queues another one.
#
#   redis://localhost:6379          docker-compose.yml brings one up
#
# **It now drives two subsystems, not one** (features/0018). Setting it also
# moves rate limiting from a per-process counter to a shared one, which is the
# point — the in-memory limit multiplies by replica count — but it has two
# consequences worth knowing before you set it:
#
#   - **A Redis outage rejects limited requests rather than letting them
#     through.** Login, registration, session refresh, invitation acceptance and
#     public form submission answer 5xx while Redis is down. The alternative
#     would be silently removing rate limiting from the whole public surface for
#     the duration, which is not a trade this product makes. Emptying this line
#     and restarting returns to per-process limits in one step.
#   - **The counters survive a restart.** Somebody who exhausts the login limit
#     stays limited for the rest of the window; restarting the API no longer
#     clears it. See docs/sot/08-operations.md for the one command that does.
REDIS_URL=

# Namespace for every key this application writes in Redis. Defaults to
# `vuepdf`, which is what lets one Redis be shared with something else.
REDIS_KEY_PREFIX=

# How many embed jobs one worker runs at once. Defaults to 5. Jobs for the same
# form never overlap regardless - that is a lock in `services/embed-queue.ts`,
# not a consequence of this number.
EMBED_WORKER_CONCURRENCY=

# How many times a failing embed is retried before the job is given up on.
# Defaults to 5, with exponential backoff. A job that exhausts them logs
# "EMBED GAVE UP" and names the form; that form's stored PDF no longer matches
# its fields until somebody saves it again.
EMBED_JOB_ATTEMPTS=

# --- Webhooks (features/0020) ------------------------------------------------
# Encrypts the signing secret of every webhook endpoint at rest. 32 bytes,
# base64:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# **Unset means webhooks cannot be configured at all** — `POST
# /api/organizations/webhooks` answers 503 and says so, rather than storing a
# secret in plaintext. Everything else in the product is unaffected.
#
# It protects nothing against a compromised application process, which holds
# this key by definition, and everything against the common incident: a leaked
# backup, a snapshot, a read-only injection.
#
# **Losing it loses every endpoint's secret.** They cannot be recovered without
# it, and rotating it means every customer's receiver starts rejecting
# signatures until they are issued new ones. Back it up like JWT_SECRET.
#
# Note that webhooks also require REDIS_URL above: delivery cannot run inline,
# because the event source is a respondent submitting a form and retries do not
# fit inside a request.
WEBHOOK_SIGNING_KEY=

# Delivery attempts before a webhook is given up on. Defaults to 5. Exhausting
# them logs "WEBHOOK GAVE UP" and names the endpoint and the event; the customer
# was not told about it.
WEBHOOK_JOB_ATTEMPTS=

# First retry delay in milliseconds, doubling each attempt. Defaults to 10000 —
# tens of seconds on purpose, because an endpoint is usually down for a minute
# while somebody deploys it, and hammering it does not help.
WEBHOOK_BACKOFF_MS=

# Deliveries in flight per worker. Defaults to 3, lower than the embed's,
# because each one holds a socket open to somebody else's server for up to ten
# seconds.
WEBHOOK_WORKER_CONCURRENCY=

# ─── Development only ────────────────────────────────────────────────────────
# Forces every organization onto one plan, ignoring what is stored in
# `organizations.plan_key`. It exists so the product can be built without
# tripping over its own limits, and it is meant to be deleted once there are
# separate environments to run in.
#
#   dev              no limits at all — the "Developer" plan
#   free | pro | team  pins everyone to that real plan, which is how the limit
#                      screens get exercised deliberately rather than by accident
#
# **Honoured only when NODE_ENV is `development` or `test`.** That is an
# allowlist, not a check for "not production": if NODE_ENV is unset, misspelled
# or lost by a process manager, the override is ignored and limits are enforced.
# Leave it empty and nothing happens.
#
# **Leave it empty when testing Stripe.** The override is applied before the
# stored plan is read, so it wins over a real subscription — billing will look
# like it works whether or not the webhook ever arrived (features/0013).
DEV_PLAN_KEY=

# ─── Error tracking ──────────────────────────────────────────────────────────
# Sentry DSN (features/0034). Leave it empty and error tracking is simply off:
# no init, no network call, no throw. A deployment without it has less
# visibility, not a fault, so it is never required.
#
# A value that is present but malformed **refuses to boot**, and that is not
# fussiness: the SDK does not reject a bad DSN, it disables itself quietly — so
# the process would start, serve, look instrumented and report nothing. Same
# treatment WEBHOOK_SIGNING_KEY gets, for the same reason.
#
# Nothing is sent when NODE_ENV is `development` or `test`, whatever is set
# here, so a developer's own crashes stay out of the deployment's project.
#
# What leaves the process is an allowlist — the message, the stack, the request
# id, the matched route, the status and which process it was. Never a request
# body: answer values arrive keyed by field id, so their paths are the
# customer's data and no redaction list could cover them.
SENTRY_DSN=

# Prove the whole path works, once, instead of waiting for a real failure.
#
# `true` makes each process send **one** event at boot, tagged with its role,
# and log that it did. Set it, redeploy, confirm you see both `api` and
# `worker` in Sentry, then **unset it** — the platform restarts services on its
# own, Sentry charges per event, and a project full of boot messages is one
# where nobody sees the real failure.
#
# It exists because the API and the worker cannot be checked from outside the
# way the SPA can, and the worker is the one that matters: nothing waits on its
# responses, so an unhandled rejection there is the only signal it produces.
SENTRY_VERIFY_ON_BOOT=

# How many backup runs to keep. Unset keeps every one of them.
#
# Opt-in on purpose: a retention policy is a decision, and something that
# deletes backups must not arrive as a default nobody chose. What this removes
# is the chore — one directory per run means pruning was always "delete the
# oldest directory", and a chore nobody automated is a volume that fills up.
#
# Pruning runs only after a **successful** backup, so a failing run never
# deletes good ones to make room for itself. A pruning failure is logged and
# does not fail the job: the backup is already taken, and a full volume makes
# the *next* run fail, which is the signal that deserves the alert.
BACKUP_KEEP=
