# Local development only. Copy to backend/.env; never use this file on Railway.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vuepdf?schema=public"
JWT_SECRET="replace-with-a-local-secret-of-at-least-32-characters"
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
FRONTEND_URL="http://localhost:5173"
BASE_URL="http://localhost:3000"
TRUST_PROXY_HOPS=0
ENABLE_HSTS=false
COOKIE_SECURE=true
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
UPLOAD_URL_TTL_SECONDS=900
INVITATION_TTL_HOURS=72

# Use the development compose Redis only when exercising the worker/queue path.
REDIS_URL=
REDIS_KEY_PREFIX=docaiflow:local
EMBED_WORKER_CONCURRENCY=1
EMBED_JOB_ATTEMPTS=5
WEBHOOK_SIGNING_KEY=
WEBHOOK_WORKER_CONCURRENCY=3
WEBHOOK_JOB_ATTEMPTS=5
WEBHOOK_BACKOFF_MS=10000

PDF_STORAGE_DRIVER=local
PDF_STORAGE_BUCKET=
PDF_STORAGE_REGION=auto
PDF_STORAGE_ENDPOINT=
PDF_STORAGE_ACCESS_KEY_ID=
PDF_STORAGE_SECRET_ACCESS_KEY=
PDF_STORAGE_FORCE_PATH_STYLE=false
PDF_STORAGE_PREFIX=pdfs/

RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_REFRESH_MAX=60
RATE_LIMIT_REFRESH_WINDOW_MS=900000
RATE_LIMIT_INVITATION_MAX=20
RATE_LIMIT_INVITATION_WINDOW_MS=900000
RATE_LIMIT_RESPONSES_MAX=20
RATE_LIMIT_RESPONSES_WINDOW_MS=600000
RATE_LIMIT_API_MAX=120
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_EXPORT_MAX=5
RATE_LIMIT_EXPORT_WINDOW_MS=3600000

# Optional Stripe test-mode group. Set all four together or leave all empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Local-only entitlement override. Never copy to a hosted environment.
DEV_PLAN_KEY=dev
