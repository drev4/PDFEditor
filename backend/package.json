{
  "name": "vuepdf-backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx watch src/worker.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "billing:reset": "tsx src/scripts/reset-billing.ts",
    "migrate:dry-run": "npm run build && node dist/scripts/migrate-existing-forms.js --dry-run",
    "migrate:run": "npm run build && node dist/scripts/migrate-existing-forms.js",
    "storage:migrate": "npm run build && node dist/scripts/migrate-pdfs-to-storage.js",
    "backup:db": "npm run build && node dist/scripts/backup-db.js",
    "backup:objects": "npm run build && node dist/scripts/backup-objects.js",
    "restore:verify": "npm run build && node dist/scripts/restore-verify.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1122.0",
    "@prisma/client": "^6.2.1",
    "@sentry/node": "^10.73.0",
    "@types/multer": "^2.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "nanoid": "^5.1.16",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "rate-limit-redis": "^6.0.1",
    "re2": "^1.26.1",
    "stripe": "^18.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "selfsigned": "^5.5.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18",
    "vitest-mock-extended": "^3.1.0"
  }
}
