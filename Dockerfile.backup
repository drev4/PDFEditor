# syntax=docker/dockerfile:1.7
#
# The scheduled backup, in its own image (features/0042).
#
# **Its own file rather than a stage in `Dockerfile.backend`, and that is not a
# style choice.** `Dockerfile.backend` says it out loud where the migrations
# stage sits: platforms that build a Dockerfile *without an explicit target* —
# Railway among them — receive whatever the final stage is, which is the serving
# image. A `backup` target there is unreachable from Railway, and the first
# attempt at this proved it: the platform ignored the Dockerfile's stages,
# fell back to its own builder, and ran a bare `tsc` at the repository root,
# where there is no `tsconfig.json`, so it printed its usage and built nothing.
#
# `Dockerfile.migrations` already exists for exactly this reason. This is its
# sibling: a short-lived job image that never serves traffic.
#
# **Why it cannot be `Dockerfile.migrations` itself.** That image needs only the
# Prisma CLI and the schema, so it never compiles anything. This one runs
# compiled application code and needs `pg_dump`, so it builds the backend and
# installs the PostgreSQL client — neither of which belongs in an image whose
# job is to apply a migration.
FROM node:22-bookworm

WORKDIR /app

COPY package.json package-lock.json ./
COPY backend/package.json ./backend/package.json
COPY frontend/package.json ./frontend/package.json
COPY backend/prisma ./backend/prisma
RUN npm ci

COPY backend/tsconfig.json ./backend/tsconfig.json
COPY backend/src ./backend/src
# Generate the client, then compile. Done here, once, so the scheduled run does
# not have a TypeScript compiler on its critical path — the first version put
# `npm run build` in the CMD and a job that takes backups should not depend on a
# compiler working at 03:00.
RUN npm run db:generate --workspace=backend \
    && npm run build --workspace=backend

# `pg_dump` refuses to run against a server newer than itself, and Debian
# bookworm ships 15 while the server is PostgreSQL 16 — so the stock package is
# silently not enough. This is the image that satisfies what the runbook asks
# for, and no other image in this repository has `pg_dump` at all.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-16 \
    && apt-get purge -y --auto-remove curl gnupg \
    && rm -rf /var/lib/apt/lists/*

# Fails at build time if the client is missing or older than the server, rather
# than on the first scheduled night.
RUN pg_dump --version

# The compiled script, not `npm run backup` — that script starts with a build.
# `backup-run.js` finds its two siblings relative to its own file, so the
# working directory does not matter to it.
CMD ["node", "backend/dist/scripts/backup-run.js"]
