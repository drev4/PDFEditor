# syntax=docker/dockerfile:1.7
#
# Railway runs a pre-deploy command inside the serving image. The serving image
# intentionally has no Prisma CLI, so migrations get their own short-lived
# image instead of making the API image larger and more privileged.
FROM node:22-bookworm

WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/package.json
COPY frontend/package.json ./frontend/package.json
COPY backend/prisma ./backend/prisma
RUN npm ci

CMD ["npm", "run", "db:migrate:deploy", "--workspace=backend"]
