# Copy to .env.deploy. Never commit the real file.
IMAGE_TAG=local
API_PORT=3000
WEB_PORT=8080

# The SPA and API must be same-site for the SameSite=Lax refresh cookie.
VITE_API_URL=https://api.example.com/api
BASE_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
TRUST_PROXY_HOPS=1

DATABASE_URL=postgresql://user:password@database.example.com:5432/vuepdf?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
REDIS_URL=rediss://user:password@redis.example.com:6380
REDIS_KEY_PREFIX=vuepdf

PDF_STORAGE_DRIVER=s3
PDF_STORAGE_BUCKET=vuepdf-production
PDF_STORAGE_REGION=auto
PDF_STORAGE_ENDPOINT=https://s3.example.com
PDF_STORAGE_ACCESS_KEY_ID=
PDF_STORAGE_SECRET_ACCESS_KEY=
PDF_STORAGE_FORCE_PATH_STYLE=false
PDF_STORAGE_PREFIX=pdfs/

ENABLE_HSTS=true
COOKIE_SECURE=true
LOG_LEVEL=info
EMBED_WORKER_CONCURRENCY=5
EMBED_JOB_ATTEMPTS=5

# Optional. Leave the whole Stripe group empty when billing is disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Optional. Empty disables outbound webhooks while PDF jobs still run.
WEBHOOK_SIGNING_KEY=
WEBHOOK_WORKER_CONCURRENCY=5
WEBHOOK_JOB_ATTEMPTS=10
WEBHOOK_BACKOFF_MS=10000

