# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local AI tooling configs.
# Skills and agents are versioned on purpose - they encode how work is done here.
# See .claude/skills/ and .claude/agents/, and docs/sot/11-conventions.md
.claude/*
!.claude/skills/
!.claude/agents/
.agents/

# Test coverage
coverage/
.nyc_output

# Vitest
.vitest
html/

# Playwright
playwright-report/
test-results/

# Test outputs
backend/test-output.txt
backend/test-output/
nul

# Environment
.env
.env.local
.env.*.local

# Vite
.vite/

# Prisma
backend/prisma/*.db
backend/prisma/*.db-journal

# POC outputs
poc/*.pdf

# Uploaded files
backend/uploads/**/*
!backend/uploads/**/.gitkeep

# Copias de .env. El patron `.env` de arriba NO las cubre — un fichero llamado
# `.env.backup-...` se commitea tan tranquilamente como cualquier otro, con el
# JWT_SECRET y la contraseña de la base de datos dentro.
.env.backup*
.env.*.backup
*.env.bak

# Backup artifacts: dumps and copied PDF documents are customer data
# (features/0037). The default output of `npm run backup:db` is backend/backups.
backups/
