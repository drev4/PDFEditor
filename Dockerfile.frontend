# syntax=docker/dockerfile:1.7
FROM node:22-bookworm AS build

WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/package.json
COPY frontend/package.json ./frontend/package.json
COPY backend/prisma ./backend/prisma
RUN npm ci

COPY frontend ./frontend
ARG VITE_API_URL
RUN node -e "const value=process.env.VITE_API_URL; if(!value) throw new Error('VITE_API_URL build arg is required'); const url=new URL(value); if(!/^https?:$/.test(url.protocol)||!url.pathname.endsWith('/api')) throw new Error('VITE_API_URL must be an absolute HTTP(S) URL ending in /api')"
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build --workspace=frontend

FROM nginx:1.30.4-alpine AS runtime
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
