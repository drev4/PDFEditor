VITE_API_URL=http://localhost:3000/api

# Sentry DSN for the SPA (features/0034). Leave empty and error tracking is off.
#
# Two things that are different from the backend's:
#
#  - **This is compile time.** Vite bakes it into the bundle at `npm run build`,
#    so it cannot be changed by restarting anything — changing it means a
#    rebuild.
#  - **It is public by design**, because it ships inside that bundle. It is not
#    a secret and must not be handled as one. The backend's SENTRY_DSN is a
#    different value and stays server-side.
#
# The ingest origin is derived from this and added to the CSP's `connect-src`
# automatically, so the two cannot disagree. A value that is not a URL fails the
# build rather than emitting a policy that would drop every report silently.
#
# Nothing is ever reported from the public form or the invitation page.
VITE_SENTRY_DSN=
