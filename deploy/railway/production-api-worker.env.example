# Paste into Railway's Raw Editor for BOTH api and worker.
# Replace only values marked REPLACE; keep Railway references literal.
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
DATABASE_URL=${{PostgresProd.DATABASE_URL}}
JWT_SECRET=REPLACE_WITH_UNIQUE_48_BYTE_BASE64_SECRET
FRONTEND_URL=https://app.docaiflow.com
BASE_URL=https://api.docaiflow.com
TRUST_PROXY_HOPS=1
ENABLE_HSTS=true
COOKIE_SECURE=true
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
UPLOAD_URL_TTL_SECONDS=900
INVITATION_TTL_HOURS=72

PDF_STORAGE_DRIVER=s3
PDF_STORAGE_BUCKET=docaiflow-prod-pdfs
PDF_STORAGE_REGION=auto
PDF_STORAGE_ENDPOINT=https://REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
PDF_STORAGE_ACCESS_KEY_ID=REPLACE_WITH_R2_PROD_ACCESS_KEY_ID
PDF_STORAGE_SECRET_ACCESS_KEY=REPLACE_WITH_R2_PROD_SECRET_ACCESS_KEY
PDF_STORAGE_FORCE_PATH_STYLE=false
PDF_STORAGE_PREFIX=pdfs/

REDIS_URL=${{RedisProd.REDIS_URL}}
REDIS_KEY_PREFIX=docaiflow:prod
EMBED_WORKER_CONCURRENCY=5
EMBED_JOB_ATTEMPTS=5
WEBHOOK_SIGNING_KEY=REPLACE_WITH_UNIQUE_32_BYTE_BASE64_SECRET
WEBHOOK_WORKER_CONCURRENCY=3
WEBHOOK_JOB_ATTEMPTS=5
WEBHOOK_BACKOFF_MS=10000

RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_REFRESH_MAX=60
RATE_LIMIT_REFRESH_WINDOW_MS=900000
RATE_LIMIT_INVITATION_MAX=20
RATE_LIMIT_INVITATION_WINDOW_MS=900000
RATE_LIMIT_RESPONSES_MAX=20
RATE_LIMIT_RESPONSES_WINDOW_MS=600000
RATE_LIMIT_API_MAX=120
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_EXPORT_MAX=5
RATE_LIMIT_EXPORT_WINDOW_MS=3600000

# Billing stays disabled until the public launch and a separate live-mode review.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
DEV_PLAN_KEY=
