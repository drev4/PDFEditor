# syntax=docker/dockerfile:1.7
FROM node:26-bookworm AS dependencies

WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/package.json
COPY frontend/package.json ./frontend/package.json
COPY backend/prisma ./backend/prisma
RUN npm ci

FROM dependencies AS build
COPY backend/tsconfig.json ./backend/tsconfig.json
COPY backend/src ./backend/src
# Generate while the Prisma CLI (a devDependency) still exists, then compile.
RUN npm run db:generate --workspace=backend \
    && npm run build --workspace=backend

FROM build AS production-dependencies
RUN npm prune --omit=dev
# npm hoists what it can to the root, so whether the backend workspace keeps a
# nested `node_modules` at all depends on which versions are installed — and
# after the pruning in features/0038 it kept none, which broke the COPY below
# with "/app/backend/node_modules: not found". The directory is guaranteed here
# so that a dependency update can never break the image build by hoisting one
# package more than the last one did.
RUN mkdir -p /app/backend/node_modules

# Release job: intentionally retains the Prisma CLI, but is never a serving image.
# It appears before runtime so platforms that build the Dockerfile without an
# explicit target (such as Railway) receive the serving image, not this job.
FROM build AS migrations
WORKDIR /app
CMD ["npm", "run", "db:migrate:deploy", "--workspace=backend"]

FROM node:26-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app/backend

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=production-dependencies --chown=node:node /app/node_modules /app/node_modules
COPY --from=production-dependencies --chown=node:node /app/backend/node_modules ./node_modules
COPY --from=build --chown=node:node /app/backend/dist ./dist
COPY --from=build --chown=node:node /app/backend/package.json ./package.json

USER node
EXPOSE 3000
CMD ["node", "dist/index.js"]

